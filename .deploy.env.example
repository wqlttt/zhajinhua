# 部署配置模板
#
#   cp .deploy.env.example .deploy.env
#   然后填上自己的服务器信息
#
# .deploy.env 已被 .gitignore 排除，不会进仓库。

SERVER_HOST=1.2.3.4
SERVER_PORT=22
SERVER_USER=root
SERVER_DIR=/opt/jinhua
SERVICE=jinhua

# 外网健康检查地址，用于部署后验证（可留空跳过）
HEALTH_URL=http://1.2.3.4:8080/health

# 登录密码。留空则只用 SSH 密钥登录（更安全，推荐）。
# 填了密码需要本机装 sshpass：brew install sshpass
SERVER_PASSWORD=
